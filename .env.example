# Copy this file to .env and fill in your own values
# Never commit the .env file — it's in .gitignore

# Anthropic API key — get yours at console.anthropic.com
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Gmail settings for sending the report
# Use a Gmail app password, not your regular password
# How to get one: myaccount.google.com → Security → 2-Step Verification → App passwords
GMAIL_USER=your-gmail-address@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password

# Where to send the daily report
RECIPIENT_EMAIL=your-email@gmail.com